APP_NAME=bookstore-api
APP_ENV=development
APP_PORT=8080
APP_DEFAULT_LANG=en
APP_LOG_LEVEL=info
APP_READ_TIMEOUT=10
APP_WRITE_TIMEOUT=15

POSTGRES_HOST_MASTER=127.0.0.1
POSTGRES_PORT_MASTER=5432
POSTGRES_USER_MASTER=bookstore
POSTGRES_PASSWORD_MASTER=secret
POSTGRES_DB_MASTER=bookstore
POSTGRES_SSLMODE_MASTER=disable

POSTGRES_HOST_SLAVE=127.0.0.1
POSTGRES_PORT_SLAVE=5432
POSTGRES_USER_SLAVE=bookstore
POSTGRES_PASSWORD_SLAVE=secret
POSTGRES_DB_SLAVE=bookstore
POSTGRES_SSLMODE_SLAVE=disable

# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=24h
