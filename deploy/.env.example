APP_NAME=bookstore-api
APP_ENV=production
APP_DEFAULT_LANG=en
APP_LOG_LEVEL=info

# Generate with: openssl rand -hex 24  (hex keeps the database URL valid)
POSTGRES_USER_MASTER=bookstore
POSTGRES_PASSWORD_MASTER=
POSTGRES_DB_MASTER=bookstore
POSTGRES_SSLMODE_MASTER=disable

# Same database as master until a read replica exists.
POSTGRES_USER_SLAVE=bookstore
POSTGRES_PASSWORD_SLAVE=
POSTGRES_DB_SLAVE=bookstore
POSTGRES_SSLMODE_SLAVE=disable

# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=24h
